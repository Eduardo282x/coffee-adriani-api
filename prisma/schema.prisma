generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id       Int    @id @default(autoincrement())
  name     String
  lastName String
  username String
  password String
  rolId    Int
  roles    Role   @relation(fields: [rolId], references: [id])

  refreshTokens RefreshToken[]

  // Verificado contra produccion: 6 usuarios, 0 usernames duplicados.
  // El login es por `username`, asi que la unicidad debe estar garantizada por
  // la base y no solo por la validacion del DTO.
  @@unique([username])
  @@index([rolId])
}

/// Sesiones de refresh.
///
/// El token NUNCA se guarda en claro: solo su SHA-256 (`tokenHash`, unico).
/// `replacedByHash` permite detectar reuso de un token ya rotado: si llega un
/// token revocado que tiene sucesor, se asume robo y se revoca toda la
/// cadena de la cuenta.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedByHash String?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  // Limpieza periodica: el cron borra tokens expirados o revocados hace dias.
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Role {
  id    Int     @id @default(autoincrement())
  rol   String
  Users Users[]
}

model Client {
  id                    Int                     @id @default(autoincrement())
  name                  String
  rif                   String
  address               String
  addressSecondary      String?
  phone                 String
  zone                  String
  blockId               Int
  block                 Block                   @relation(fields: [blockId], references: [id])
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  invoices              Invoice[]
  ClientReminder        ClientReminder[]
  ClientReminderHistory ClientReminderHistory[]
  Notification          Notification[]

  // Filtro por block en listados de facturas y reportes por zona.
  @@index([blockId])
}

model Block {
  id      Int      @id @default(autoincrement())
  name    String
  address String
  clients Client[]
}

model Invoice {
  id             Int              @id @default(autoincrement())
  client         Client           @relation(fields: [clientId], references: [id])
  clientId       Int
  dispatchDate   DateTime
  dueDate        DateTime
  controlNumber  String           @unique
  exchangeRate   Int?
  sellerId       Int?
  seller         Seller?          @relation(fields: [sellerId], references: [id])
  totalAmount    Decimal          @db.Decimal(10, 2)
  consignment    Boolean
  status         InvoiceStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deleted        Boolean          @default(false)
  invoiceItems   InvoiceProduct[]
  InvoicePayment InvoicePayment[]

  // Antes solo existian el PK y el indice unico de controlNumber: 8481 filas
  // se escaneaban completas en cada listado, en cada reporte y en cada
  // `count`. `deleted` encabeza los indices porque todas las consultas de
  // negocio filtran soft-delete y hoy la columna no tiene indice alguno.
  @@index([deleted, dispatchDate])
  @@index([clientId, status])
  @@index([status, dispatchDate])
  @@index([sellerId])
  @@index([dueDate])
}

enum InvoiceStatus {
  Creada
  Pendiente
  Pagado
  Vencida
  Cancelada
  Perdidas
}

model Product {
  id                    Int                    @id @default(autoincrement())
  name                  String
  presentation          String
  type                  String                 @default("Cafe")
  priorityOrder         Int                    @default(0)
  purchasePrice         Decimal                @db.Decimal(10, 2)
  purchasePriceUSD      Decimal                @default(0) @db.Decimal(10, 2)
  price                 Decimal                @db.Decimal(10, 2)
  priceUSD              Decimal                @db.Decimal(10, 2)
  amount                Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventoryMovements    Inventory[]
  invoiceItems          InvoiceProduct[]
  HistoryInventory      HistoryInventory[]
  inventoryEntryDetails InventoryEntryDetail[]
  inventoryCutDetails   InventoryCutDetail[]
  inventoryLosses       InventoryLoss[]
  deleted               Boolean                @default(false)
}

model HistoryProduct {
  id               Int      @id @default(autoincrement())
  name             String
  presentation     String
  purchasePrice    Decimal  @db.Decimal(10, 2)
  purchasePriceUSD Decimal  @default(0) @db.Decimal(10, 2)
  price            Decimal  @db.Decimal(10, 2)
  priceUSD         Decimal  @db.Decimal(10, 2)
  amount           Int
  createdAt        DateTime @default(now())
}

model Inventory {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  quantity  Decimal  @db.Decimal(10, 3)
  createdAt DateTime @default(now())

  // `findFirst({ where: { productId } })` devolvia una fila arbitraria si
  // habia mas de una, y los locks por `id` no protegian el producto. Ahora la
  // fila es unica por producto. Verificado en produccion: 23 filas, 23
  // productos, 0 duplicados, asi que el indice se crea sin limpieza previa.
  @@unique([productId])
}

enum InventoryType {
  ADJUSTMENT
  IN
  OUT
  EDIT
}

model HistoryInventory {
  id            Int           @id @default(autoincrement())
  product       Product       @relation(fields: [productId], references: [id])
  productId     Int
  quantity      Int
  controlNumber String        @default("")
  description   String        @default("")
  movementType  InventoryType
  movementDate  DateTime      @default(now())

  // Tabla legacy: 14 387 filas que el codigo actual no lee ni escribe. Se
  // indexa para no penalizar consultas administrativas manuales, pero debe
  // evaluarse su archivo: sigue creciendo sin destino.
  @@index([productId, movementDate])
  @@index([movementDate])
}

model HistoryDolar {
  id      Int       @id @default(autoincrement())
  dolar   Decimal   @db.Decimal(10, 2)
  date    DateTime  @default(now())
  Payment Payment[]

  // La tasa vigente se busca por la fecha mas reciente.
  @@index([date])
}

model InvoiceProduct {
  id           Int                @id @default(autoincrement())
  invoice      Invoice            @relation(fields: [invoiceId], references: [id])
  invoiceId    Int
  product      Product            @relation(fields: [productId], references: [id])
  productId    Int
  quantity     Decimal            @db.Decimal(10, 4)
  type         InvoiceTypeProduct @default(SALE)
  unitPriceUSD Decimal            @default(0) @db.Decimal(10, 2)
  unitPrice    Decimal            @db.Decimal(10, 2)
  subtotal     Decimal            @db.Decimal(10, 2)

  @@unique([invoiceId, productId, type]) // No se puede repetir el producto en la misma factura
  // El unique solo cubre el prefijo (invoiceId, productId, ...). Todos los
  // reportes de dashboard filtran por `product.type`, que require el join
  // desde este lado: sin indice sobre 15 487 filas era un seq scan por request.
  @@index([productId])
}

enum InvoiceTypeProduct {
  GIFT
  SALE
}

model AccountsPayments {
  id        Int           @id @default(autoincrement())
  name      String
  bank      String
  methodId  Int
  method    PaymentMethod @relation(references: [id], fields: [methodId])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  Payment   Payment[]

  // Varias cuentas apuntan al mismo metodo (p. ej. varias cuentas de
  // transferencia). El filtro de gastos lo recorre por metodo.
  @@index([methodId])
}

model Payment {
  id                     Int                     @id @default(autoincrement())
  amount                 Decimal                 @db.Decimal(10, 2)
  accountId              Int
  account                AccountsPayments        @relation(fields: [accountId], references: [id])
  reference              String
  description            String                  @default("")
  dolarId                Int
  dolar                  HistoryDolar            @relation(fields: [dolarId], references: [id])
  paymentDate            DateTime
  status                 PaymentStatus
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deleted                Boolean                 @default(false)
  type                   AccountType             @default(INCOME)
  InvoicePayment         InvoicePayment[]
  inventoryEntryPayments InventoryEntryPayment[]

  // 9858 filas y ni un indice fuera del PK: los reportes de pagos por rango de
  // fecha con filtro de soft-delete hacian seq scan + sort.
  @@index([deleted, paymentDate])
  @@index([accountId])
  @@index([dolarId])
}

model InvoicePayment {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  paymentId Int
  amount    Decimal @db.Decimal(10, 2) // Monto asignado de este pago a esta factura

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([invoiceId, paymentId]) // No se puede repetir la relación
  // El balance disponible de un pago se calcula sumando sus asignaciones, y
  // eso empieza por `WHERE "paymentId" = ?`. El unique (invoiceId, paymentId)
  // no sirve para esa consulta porque `paymentId` no es su columna inicial.
  @@index([paymentId])
}

model PaymentMethod {
  id               Int                @id @default(autoincrement())
  name             String
  currency         Currency
  AccountsPayments AccountsPayments[]
}

enum PaymentStatus {
  CONFIRMED
  PENDING
}

enum Currency {
  USD
  BS
}

enum AccountType {
  INCOME
  EXPENSE
  SUPPLIER
  PERSONAL_EXPENSES
}

enum EntryStatus {
  CREADA
  PENDIENTE
  PAGADO
  CANCELADA
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
  Client    Client   @relation(fields: [clientId], references: [id])
  clientId  Int

  // Listado de no vistas y purga de inactividad por cliente.
  @@index([seen, createdAt])
  @@index([clientId])
}

model Seller {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String
  commission Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sales      Sale[]
  Invoice    Invoice[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  seller    Seller   @relation(fields: [sellerId], references: [id])
  sellerId  Int
  total     Int
  saleDate  DateTime
  createdAt DateTime @default(now())
}

model Supplier {
  id               Int              @id @default(autoincrement())
  name             String
  rif              String?
  phone            String?
  address          String?
  email            String?
  rubro            String           @default("")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  inventoryEntries InventoryEntry[]
}

model ErrorMessages {
  id        Int      @id @default(autoincrement())
  message   String
  from      String
  createdAt DateTime @default(now())

  // Crecen de forma indefinida y se consultan por fecha en el panel.
  @@index([createdAt])
  @@index([from])
}

model Message {
  id                    Int                     @id @default(autoincrement())
  title                 String                  @db.VarChar(100) // Título opcional
  content               String                  @db.Text // Mensaje largo con saltos de línea, emojis, etc.
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  ClientReminder        ClientReminder[]
  ClientReminderHistory ClientReminderHistory[]
}

model ClientReminder {
  id        Int       @id @default(autoincrement())
  clientId  Int
  messageId Int
  send      Boolean   @default(false) // Marcar si se va a enviar o no
  sentAt    DateTime? // Fecha en la que realmente fue enviado (opcional)
  client    Client    @relation(fields: [clientId], references: [id])
  message   Message   @relation(fields: [messageId], references: [id])
  createdAt DateTime  @default(now())

  // NO se hace `@@unique([clientId])` a proposito: produccion tiene 2 clientes
  // con mas de un recordatorio y la app borra por `clientId`. El indice
  // acelera esas consultas; la deduplicacion queda como reporte de limpieza.
  @@index([clientId])
  @@index([send, sentAt])
}

model ClientReminderHistory {
  id          Int       @id @default(autoincrement())
  clientId    Int
  messageId   Int
  description String
  sended      Boolean   @default(false) // Marcar si se va a enviar o no
  sentAt      DateTime? // Fecha en la que realmente fue enviado (opcional)
  client      Client    @relation(fields: [clientId], references: [id])
  message     Message   @relation(fields: [messageId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([clientId])
}

model Settings {
  id    Int    @id @default(autoincrement())
  name  String
  value String
}

model InventoryEntry {
  id            Int                     @id @default(autoincrement())
  controlNumber String                  @unique
  movementType  InventoryType
  totalAmount   Decimal                 @db.Decimal(10, 2)
  status        EntryStatus             @default(CREADA)
  title         String                  @default("")
  description   String                  @default("")
  date          DateTime
  supplierId    Int?
  supplier      Supplier?               @relation(fields: [supplierId], references: [id])
  details       InventoryEntryDetail[]
  payments      InventoryEntryPayment[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([date])
  @@index([supplierId])
  @@index([status, date])
}

model InventoryEntryDetail {
  id               Int                @id @default(autoincrement())
  inventoryEntryId Int
  inventoryEntry   InventoryEntry     @relation(fields: [inventoryEntryId], references: [id])
  productId        Int
  product          Product            @relation(fields: [productId], references: [id])
  quantity         Decimal            @db.Decimal(10, 3)
  unitPrice        Decimal            @db.Decimal(10, 2)
  unitPriceUSD     Decimal            @db.Decimal(10, 2)
  subtotal         Decimal            @db.Decimal(10, 2)
  type             InvoiceTypeProduct @default(SALE)

  @@unique([inventoryEntryId, productId, type])
  // El reporte de inventario inicial agrupa movimientos por producto, luego
  // filtra por `inventoryEntry.date`.
  @@index([productId])
}

model InventoryEntryPayment {
  id               Int            @id @default(autoincrement())
  inventoryEntryId Int
  inventoryEntry   InventoryEntry @relation(fields: [inventoryEntryId], references: [id])
  paymentId        Int
  payment          Payment        @relation(fields: [paymentId], references: [id])
  amount           Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())

  @@unique([inventoryEntryId, paymentId])
}

model InventoryCut {
  id        Int                  @id @default(autoincrement())
  startDate String
  endDate   String
  type      String
  period    String               @default("WEEK")
  status    String               @default("OPEN")
  createdAt DateTime             @default(now())
  details   InventoryCutDetail[]

  // SIN `@@unique([type, period, startDate, endDate])` a proposito: produccion
  // ya tiene 20 grupos de cortes duplicados y el indice unico haria fallar la
  // migracion. Hay que corregir la logica que los genera y limpiar, y solo
  // entonces agregar la restriccion.
  @@index([type, period, startDate])
  @@index([status])
}

model InventoryCutDetail {
  id             Int          @id @default(autoincrement())
  inventoryCutId Int
  inventoryCut   InventoryCut @relation(fields: [inventoryCutId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  amount         Decimal      @db.Decimal(10, 3)

  @@index([productId])
}

model InventoryLoss {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @db.Decimal(10, 3)
  unitCost  Decimal  @db.Decimal(10, 2)
  totalCost Decimal  @db.Decimal(10, 2)
  reason    String   @default("")
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([productId, date])
}

model WeeklyReportSnapshot {
  id        Int      @id @default(autoincrement())
  type      String
  weekStart DateTime
  weekEnd   DateTime
  fileName  String
  file      Bytes    @db.ByteA
  createdAt DateTime @default(now())

  @@unique([type, weekStart])
}
