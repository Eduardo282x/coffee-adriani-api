    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
