{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "coffee_adriani_mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
      ],
      "enabled": true
    }
  }
}
